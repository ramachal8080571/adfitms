{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adfitms"
		},
		"DS_ITMS_INPUT_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'DS_ITMS_INPUT'"
		},
		"LS_ITMS_OUT_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_ITMS_OUT'"
		},
		"DS_ITMS_INPUT_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://itmsscr.dfs.core.windows.net/"
		},
		"LS_ITMS_OUT_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://itmsdst1.dfs.core.windows.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adfitms_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"DS_ITMS_INPUT_accountKey": {
						"value": "[parameters('DS_ITMS_INPUT_accountKey')]"
					},
					"LS_ITMS_OUT_accountKey": {
						"value": "[parameters('LS_ITMS_OUT_accountKey')]"
					},
					"DS_ITMS_INPUT_properties_typeProperties_url": {
						"value": "[parameters('DS_ITMS_INPUT_properties_typeProperties_url')]"
					},
					"LS_ITMS_OUT_properties_typeProperties_url": {
						"value": "[parameters('LS_ITMS_OUT_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}